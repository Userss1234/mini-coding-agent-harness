# DeepSeek/OpenAI-compatible model client
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Agent evaluation
AGENT_EVAL_MAX_TURNS=12

# Retrieval preflight evidence budget
AGENT_RETRIEVAL_GATE_THRESHOLD=2
AGENT_RETRIEVAL_PREFLIGHT_LIMIT=2
AGENT_RETRIEVAL_PREFLIGHT_CHUNK_LINES=48
AGENT_RETRIEVAL_PREFLIGHT_READ_WINDOW=8
AGENT_RETRIEVAL_PREFLIGHT_MAX_CHARS_PER_READ=1400
AGENT_RETRIEVAL_PREFLIGHT_MAX_CHARS=2400

# Retrieval backend: lexical (base install) or hybrid (pip install -e ".[retrieval]")
HARNESS_RETRIEVAL_BACKEND=lexical
HARNESS_RETRIEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HARNESS_RETRIEVAL_CACHE_DIR=
HARNESS_RETRIEVAL_LEXICAL_WEIGHT=0.35
HARNESS_RETRIEVAL_SEMANTIC_WEIGHT=0.65

# Command execution backend: host or docker
HARNESS_EXECUTION_BACKEND=host
HARNESS_DOCKER_IMAGE=mini-coding-agent-harness-sandbox:latest
HARNESS_DOCKER_NETWORK=none
HARNESS_DOCKER_CPUS=1.0
HARNESS_DOCKER_MEMORY=512m
HARNESS_DOCKER_PIDS_LIMIT=256
HARNESS_DOCKER_USER=10001:10001
HARNESS_DOCKER_TMPFS_SIZE=64m
HARNESS_DOCKER_READ_ONLY_ROOT=true
# Set to host only when an explicit non-isolated fallback is acceptable.
HARNESS_DOCKER_FALLBACK=

# Anthropic-compatible alternative
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# MODEL_ID=
